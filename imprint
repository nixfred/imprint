#!/usr/bin/env bash
# Imprint — stamp one Omarchy machine onto another.
set -euo pipefail

SOURCE=${BASH_SOURCE[0]}
while [[ -L $SOURCE ]]; do
  dir=$(cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink -- "$SOURCE")
  [[ $SOURCE == /* ]] || SOURCE="$dir/$SOURCE"
done
ROOT="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
if [[ -f $ROOT/imprint-engine.py ]]; then
  ENGINE="$ROOT/imprint-engine.py"
elif [[ -f $ROOT/tool/imprint-engine.py ]]; then
  ENGINE="$ROOT/tool/imprint-engine.py"
else
  echo "imprint: cannot find imprint-engine.py next to $SOURCE" >&2
  exit 1
fi

engine() {
  python3 "$ENGINE" "$@"
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "imprint: $1 is required" >&2
    exit 1
  }
}

need python3
need tar
need zstd

HAVE_GUM=0
if command -v gum >/dev/null 2>&1; then
  HAVE_GUM=1
fi

accent="${GUM_CHOOSE_SELECTED_FOREGROUND:-#7aa2f7}"
muted="${GUM_CONFIRM_PROMPT_FOREGROUND:-#8E969E}"
text="${GUM_FILTER_HEADER_FOREGROUND:-#EAECEE}"

banner() {
  local logo
  if [[ -r /usr/share/omarchy/logo.txt ]]; then
    logo=$(cat /usr/share/omarchy/logo.txt)
  else
    logo='OMARCHY'
  fi
  if (( HAVE_GUM )); then
    gum style --foreground "$accent" --bold --align center --width 92 "$logo"
    gum style --foreground "$text" --bold --align center --width 92 "IMPRINT"
    gum style --foreground "$muted" --italic --align center --width 92 \
      "Stamp one Omarchy onto another · tab or x toggles · a all · enter confirms"
    echo
  else
    printf '%s\n' "$logo"
    echo "IMPRINT"
    echo
  fi
}

say() {
  if (( HAVE_GUM )); then
    gum style --foreground "$text" -- "$@"
  else
    printf '%s\n' "$*"
  fi
}

warn() {
  if (( HAVE_GUM )); then
    gum style --foreground "#E0AF68" -- "$@"
  else
    printf 'warning: %s\n' "$*"
  fi
}

die() {
  echo "imprint: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Imprint — save an Omarchy machine to a file, restore it onto another.

Usage:
  imprint                     Interactive menu
  imprint save                Choose categories, write an archive
  imprint save --all -o FILE
  imprint save --only scripts,cli      Just the scripts, no plugins
  imprint save --only look,bar,plugins
  imprint restore [FILE]      Choose categories from an archive
  imprint restore FILE --only bar,plugins --dry-run
  imprint restore FILE --upgrade      Run `omarchy update -y` first, then restore
  imprint restore FILE --only system --allow-system
                                      Apply /etc changes and enable system units
  imprint plan FILE           Write a reviewable restore.sh you can read first
  imprint plan FILE --only plugins -o ~/myplan
  imprint info FILE           Show the machine brief (AI-readable)
  imprint diff FILE           What drifted since this imprint
  imprint verify FILE         Check the archive
  imprint undo                Put back files from the last restore
  imprint list                Archives in ~/imprints

In the picker: tab or x toggles a category, a selects all, enter confirms.
Space does nothing -- gum 2.x does not bind it. Identity, monitors, input
and secrets stay off unless you turn them on.
EOF
}

catalog_rows() {
  # id <TAB> display label <TAB> default(1/0), optionally filtered to an archive.
  local archive=${1:-}
  python3 - "$ENGINE" "$archive" <<'PY'
import json, subprocess, sys
engine = sys.argv[1]
archive = sys.argv[2] if len(sys.argv) > 2 else ""
catalog = json.loads(subprocess.check_output(["python3", engine, "categories"], text=True))
present = None
if archive:
    man = json.loads(subprocess.check_output(["python3", engine, "info", archive, "--json"], text=True))
    present = set((man.get("categories") or {}).keys())
note = {"host": "  [this machine]", "identity": "  [hostname]", "secrets": "  [keys]"}
for item in catalog:
    if present is not None and item["id"] not in present:
        continue
    # gum --selected is a comma separated list, so labels must carry no commas.
    summary = item["summary"].replace(",", " \u00b7")
    label = f"{item['title']} \u2014 {summary}{note.get(item.get('risk') or '', '')}"
    print("\t".join([item["id"], label, "1" if item.get("default") else "0"]))
PY
}

default_ids() {
  catalog_rows "${1:-}" | awk -F'\t' '$3=="1"{print $1}' | paste -sd, -
}

default_selected() {
  default_ids ""
}

ids_from_archive_defaults() {
  default_ids "$1"
}

choose_categories() {
  local header=$1
  local preselect=$2
  local archive=${3:-}
  need gum
  local rows
  rows=$(catalog_rows "$archive") || return 1
  [[ -n $rows ]] || die "no categories to choose"

  # Options are the display labels only. Passing "label<TAB>id" via
  # --label-delimiter makes gum re-sort the list alphabetically, which throws
  # away the catalog order that puts host-bound and secret categories last.
  local labels selected
  labels=$(printf '%s\n' "$rows" | awk -F'\t' '{print $2}')
  selected=$(printf '%s\n' "$rows" \
    | awk -F'\t' -v want=",$preselect," 'index(want, "," $1 ",") {print $2}' \
    | paste -sd, -)

  local args=(
    choose --no-limit
    --height=18
    --show-help
    --cursor="▸ "
    --cursor-prefix="○ "
    --selected-prefix="◉ "
    --unselected-prefix="○ "
    --header="$header  (tab or x toggles · a selects all · enter confirms)"
  )
  if [[ -n $selected ]]; then
    args+=(--selected="$selected")
  fi
  local picked
  picked=$(printf '%s\n' "$labels" | gum "${args[@]}") || return 1
  [[ -n $picked ]] || return 1
  # Map chosen labels back to ids, emitted in catalog order.
  awk -F'\t' 'NR==FNR{sel[$0]=1; next} sel[$2]{print $1}' \
    <(printf '%s\n' "$picked") <(printf '%s\n' "$rows") | paste -sd, -
}

pick_archive() {
  local start=${1:-$HOME/imprints}
  mkdir -p "$start"
  if (( HAVE_GUM )); then
    gum file --directory=false --height=16 --header="Choose an imprint archive" "$start"
  else
    ls -1 "$start"/imprint-*.tar.zst 2>/dev/null | tail -n 1
  fi
}

confirm() {
  local prompt=$1
  if (( HAVE_GUM )); then
    gum confirm "$prompt"
  else
    printf '%s [y/N] ' "$prompt"
    read -r ans
    [[ $ans == y || $ans == Y ]]
  fi
}

do_save() {
  local only=${1:-}
  local output=${2:-}
  local all=${3:-0}
  banner
  if [[ -z $only && $all -eq 0 ]]; then
    only=$(choose_categories "What should this imprint carry?" "$(default_selected)") \
      || die "cancelled"
  fi
  if [[ -z $output ]]; then
    local host
    host=$(hostname)
    mkdir -p "$HOME/imprints"
    output="$HOME/imprints/imprint-${host}-$(date +%Y%m%d-%H%M).tar.zst"
    if (( HAVE_GUM )); then
      output=$(gum input --header="Write archive to" --value="$output")
    fi
  fi
  [[ -n $output ]] || die "no output path"
  say "Saving $( [[ $all -eq 1 ]] && echo all categories || echo "$only" )"
  say "→ $output"
  if (( HAVE_GUM )); then
    if [[ $all -eq 1 ]]; then
      gum spin --spinner dot --title "Collecting this machine…" -- \
        python3 "$ENGINE" save --all -o "$output"
    else
      gum spin --spinner dot --title "Collecting this machine…" -- \
        python3 "$ENGINE" save --only "$only" -o "$output"
    fi
  else
    if [[ $all -eq 1 ]]; then
      engine save --all -o "$output"
    else
      engine save --only "$only" -o "$output"
    fi
  fi
  say "Wrote $output"
  if command -v du >/dev/null; then
    say "Size $(du -h "$output" | awk '{print $1}')"
  fi
}

do_restore() {
  local archive=${1:-}
  local only=${2:-}
  local dry=${3:-0}
  local confirm_host=${4:-}
  local upgrade=${5:-0}
  local allow_system=${6:-0}
  banner
  if [[ -z $archive ]]; then
    archive=$(pick_archive) || die "cancelled"
  fi
  [[ -n $archive && -e $archive ]] || die "archive not found: $archive"
  say "Archive $archive"
  engine verify "$archive" >/dev/null || die "archive failed verify"
  if (( HAVE_GUM )); then
    engine info "$archive" | gum pager --timeout=0s || true
  else
    engine info "$archive"
  fi
  if [[ -z $only ]]; then
    only=$(choose_categories "What should land on this machine?" "$(ids_from_archive_defaults "$archive")" "$archive") \
      || die "cancelled"
  fi
  if printf '%s' "$only" | grep -q 'identity'; then
    warn "Identity will rename this host. Restore still needs --confirm-hostname."
  fi
  if printf '%s' "$only" | grep -q 'system'; then
    warn "System layer needs root. Without --allow-system it only writes a script for you to review."
  fi
  if printf '%s' "$only" | grep -q 'secrets'; then
    warn "Secrets copies SSH public keys and config, not private keys."
  fi
  local extra=()
  (( dry == 1 )) && extra+=(--dry-run)
  (( upgrade == 1 )) && extra+=(--upgrade)
  (( allow_system == 1 )) && extra+=(--allow-system)
  # These were parsed and then thrown away on the interactive path.
  [[ -n $confirm_host ]] && extra+=(--confirm-hostname "$confirm_host")
  if [[ $dry -eq 0 ]]; then
    confirm "Restore selected categories onto this machine?" || die "cancelled"
  fi
  say "Restoring $only"
  if (( HAVE_GUM )) && [[ $dry -eq 0 ]]; then
    gum spin --spinner dot --title "Applying imprint…" -- \
      python3 "$ENGINE" restore "$archive" --only "$only" "${extra[@]}"
  else
    engine restore "$archive" --only "$only" "${extra[@]}"
  fi
}

do_list() {
  mkdir -p "$HOME/imprints"
  banner
  local files
  files=$(ls -1t "$HOME/imprints"/imprint-*.tar.zst 2>/dev/null || true)
  if [[ -z $files ]]; then
    say "No archives in ~/imprints yet. Run imprint save."
    return 0
  fi
  if (( HAVE_GUM )); then
    printf '%s\n' "$files" | while read -r f; do
      printf '%s  %s\n' "$(du -h "$f" | awk '{print $1}')" "$f"
    done | gum style --foreground "$text" --border rounded --padding "1 2" --border-foreground "$accent"
  else
    ls -lh "$HOME/imprints"/imprint-*.tar.zst
  fi
}

main_menu() {
  banner
  need gum
  local choice
  choice=$(gum choose --header="What do you want to do?" \
    --cursor="▸ " --height=10 \
    "Save this machine" \
    "Restore onto this machine" \
    "Inspect an imprint" \
    "Diff against this machine" \
    "Undo last restore" \
    "List archives" \
    "Quit") || exit 0
  case $choice in
    "Save this machine") do_save ;;
    "Restore onto this machine") do_restore ;;
    "Inspect an imprint")
      local f
      f=$(pick_archive) || exit 0
      engine info "$f" | gum pager --timeout=0s
      ;;
    "Diff against this machine")
      local f
      f=$(pick_archive) || exit 0
      engine diff "$f" | gum pager --timeout=0s
      ;;
    "Undo last restore")
      confirm "Put back files from the last restore?" || exit 0
      engine undo
      ;;
    "List archives") do_list ;;
    "Quit") exit 0 ;;
  esac
}

cmd=${1:-}
shift || true

case $cmd in
  "" ) main_menu ;;
  -h|--help|help) usage ;;
  save)
    only=""
    output=""
    all=0
    while [[ $# -gt 0 ]]; do
      case $1 in
        --only) [[ $# -ge 2 ]] || die "--only needs a value"; only=$2; shift 2 ;;
        --all) all=1; shift ;;
        -o|--output) [[ $# -ge 2 ]] || die "--output needs a value"; output=$2; shift 2 ;;
        --yes) shift ;;
        *) die "unknown save flag: $1" ;;
      esac
    done
    if [[ -n $only || $all -eq 1 || $HAVE_GUM -eq 0 ]]; then
      [[ $all -eq 1 ]] || [[ -n $only ]] || only=$(default_selected)
      args=(save)
      [[ $all -eq 1 ]] && args+=(--all)
      [[ -n $only && $all -eq 0 ]] && args+=(--only "$only")
      [[ -n $output ]] && args+=(-o "$output")
      engine "${args[@]}"
    else
      do_save "$only" "$output" "$all"
    fi
    ;;
  restore)
    archive=""
    only=""
    dry=0
    upgrade=0
    allow_system=0
    confirm_host=""
    while [[ $# -gt 0 ]]; do
      case $1 in
        --only) [[ $# -ge 2 ]] || die "--only needs a value"; only=$2; shift 2 ;;
        --dry-run) dry=1; shift ;;
        --upgrade) upgrade=1; shift ;;
        --allow-system) allow_system=1; shift ;;
        --confirm-hostname) [[ $# -ge 2 ]] || die "--confirm-hostname needs a value"; confirm_host=$2; shift 2 ;;
        --yes) shift ;;
        -*) die "unknown restore flag: $1" ;;
        *) archive=$1; shift ;;
      esac
    done
    extra=()
    [[ $dry -eq 1 ]] && extra+=(--dry-run)
    [[ $upgrade -eq 1 ]] && extra+=(--upgrade)
    [[ $allow_system -eq 1 ]] && extra+=(--allow-system)
    [[ -n $confirm_host ]] && extra+=(--confirm-hostname "$confirm_host")
    if [[ -n $only && -n $archive ]]; then
      engine restore "$archive" --only "$only" "${extra[@]}"
    else
      do_restore "$archive" "$only" "$dry" "$confirm_host" "$upgrade" "$allow_system"
    fi
    ;;
  plan)
    [[ $# -ge 1 ]] || die "usage: imprint plan FILE [--only ...] [-o DIR]"
    engine plan "$@"
    ;;
  info|brief)
    [[ $# -ge 1 ]] || die "usage: imprint info FILE"
    engine info "$@"
    ;;
  diff)
    [[ $# -ge 1 ]] || die "usage: imprint diff FILE"
    engine diff "$1"
    ;;
  verify)
    [[ $# -ge 1 ]] || die "usage: imprint verify FILE"
    engine verify "$1"
    ;;
  undo)
    engine undo "$@"
    ;;
  list)
    do_list
    ;;
  categories)
    engine categories
    ;;
  *)
    usage
    exit 2
    ;;
esac
