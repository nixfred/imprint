#!/usr/bin/env bash
# Imprint — stamp one Omarchy machine onto another.
set -euo pipefail

SOURCE=${BASH_SOURCE[0]}
while [[ -L $SOURCE ]]; do
  dir=$(cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink -- "$SOURCE")
  [[ $SOURCE == /* ]] || SOURCE="$dir/$SOURCE"
done
ROOT="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
if [[ -f $ROOT/imprint-engine.py ]]; then
  ENGINE="$ROOT/imprint-engine.py"
elif [[ -f $ROOT/tool/imprint-engine.py ]]; then
  ENGINE="$ROOT/tool/imprint-engine.py"
else
  echo "imprint: cannot find imprint-engine.py next to $SOURCE" >&2
  exit 1
fi

engine() {
  python3 "$ENGINE" "$@"
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "imprint: $1 is required" >&2
    exit 1
  }
}

need python3
need tar

# gum's pickers need a real terminal. Without one -- cron, ssh without -t, a
# pipeline -- fall back to the non-interactive path instead of dying on
# "could not open TTY".
# Interactive menus need a terminal, nothing more -- gum is no longer used.
HAVE_GUM=0
if [[ -t 0 && -t 1 ]]; then
  HAVE_GUM=1
fi

# Colours come from the active Omarchy theme, via the engine.
IMP_ACCENT='' IMP_GREEN='' IMP_AMBER='' IMP_RED='' IMP_GREY='' IMP_BLUE='' IMP_RESET='' IMP_BOLD=''
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  eval "$(engine palette 2>/dev/null || true)"
fi

# IMPRINT in the same block font as the Omarchy wordmark, at half its height.
IMPRINT_WORDMARK=$(cat <<'WORDMARK'
██████  ██      ██  ███████   ███████   ██████  ██     ██  ██████████
  ██    ████  ████  ██    ██  ██    ██    ██    ███    ██      ██
  ██    ██ ████ ██  ███████   ███████     ██    ██ ██  ██      ██
  ██    ██  ██  ██  ██        ██   ██     ██    ██   ████      ██
██████  ██      ██  ██        ██    ██  ██████  ██     ██      ██
WORDMARK
)

clear_screen() {
  # Only when a person is watching: clearing a redirected or piped stdout just
  # injects escape codes into whatever is capturing it.
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then
    tput clear 2>/dev/null && return 0
  fi
  # Home, erase screen, erase scrollback.
  printf '\033[H\033[2J\033[3J'
}

banner() {
  clear_screen
  local logo
  if [[ -r /usr/share/omarchy/logo.txt ]]; then
    logo=$(cat /usr/share/omarchy/logo.txt)
  else
    logo='OMARCHY'
  fi
  printf '%s%s%s\n' "$IMP_ACCENT" "$logo" "$IMP_RESET"
  printf '%s%s%s\n' "$IMP_BOLD" "$IMPRINT_WORDMARK" "$IMP_RESET"
  printf '%s  Stamp one Omarchy onto another · space selects · ▸ opens a submenu%s\n\n' \
    "$IMP_GREY" "$IMP_RESET"
}

say() {
  printf '  %s\n' "$*"
}

warn() {
  printf '  %s%s%s\n' "$IMP_AMBER" "$*" "$IMP_RESET"
}

die() {
  echo "imprint: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Imprint — save an Omarchy machine to a file, restore it onto another.

Usage:
  imprint                     Interactive menu
  imprint save                Choose categories, write an archive
  imprint save --all -o FILE
  imprint save --only scripts,cli      Just the scripts, no plugins
  imprint save --only look,bar,plugins
  imprint restore [FILE]      Pick what to restore, review the changes, confirm
  imprint preview FILE        Show what a restore would change, and stop
  imprint restore FILE --only bar,plugins --dry-run
  imprint restore FILE --upgrade      Run `omarchy update -y` first, then restore
  imprint restore FILE --only system --allow-system
                                      Apply /etc changes and enable system units
  imprint plan FILE           Write a reviewable restore.sh you can read first
  imprint plan FILE --only plugins -o ~/myplan
  imprint apply DIR           Run a plan, recording each step; resumable
  imprint apply DIR --resume  Continue after a failure or interruption
  imprint info FILE           Show the machine brief (AI-readable)
  imprint diff FILE           What drifted since this imprint
  imprint verify FILE         Check the archive
  imprint undo                Put back files from the last restore
  imprint list                Archives in ~/imprints
  imprint facts               This machine as JSON
  imprint about               Version, author and links

In the picker: space toggles the highlighted row. A row marked ▸ has a
submenu -- space opens it, ← goes back. The top row selects everything and
stays put so you can keep editing. Nothing runs until you pick the
"▶ Start backup" row at the bottom. Identity, monitors, input and secrets
stay off unless you turn them on.
EOF
}

catalog_rows() {
  # id <TAB> display label <TAB> default(1/0), optionally filtered to an archive.
  local archive=${1:-}
  python3 - "$ENGINE" "$archive" <<'PY'
import json, subprocess, sys
engine = sys.argv[1]
archive = sys.argv[2] if len(sys.argv) > 2 else ""
catalog = json.loads(subprocess.check_output(["python3", engine, "categories"], text=True))
present = None
if archive:
    man = json.loads(subprocess.check_output(["python3", engine, "info", archive, "--json"], text=True))
    present = set((man.get("categories") or {}).keys())
note = {"host": "  [this machine]", "identity": "  [hostname]", "secrets": "  [keys]"}
for item in catalog:
    if present is not None and item["id"] not in present:
        continue
    # gum --selected is a comma separated list, so labels must carry no commas.
    summary = item["summary"].replace(",", " \u00b7")
    label = f"{item['title']} \u2014 {summary}{note.get(item.get('risk') or '', '')}"
    print("\t".join([item["id"], label, "1" if item.get("default") else "0"]))
PY
}

default_ids() {
  catalog_rows "${1:-}" | awk -F'\t' '$3=="1"{print $1}' | paste -sd, -
}

default_selected() {
  default_ids ""
}

ids_from_archive_defaults() {
  default_ids "$1"
}

SELECTION_FILE=""

# Our own picker: space toggles, space on a row with a submenu walks into it,
# and the top row selects everything. gum choose can do none of that.
choose_categories() {
  local header=$1
  local archive=${2:-}
  SELECTION_FILE=$(mktemp -t imprint-selection-XXXXXX.json)
  local args=(pick --header "$header" --action "${PICK_ACTION:-Start backup}")
  [[ -n $archive ]] && args+=(--archive "$archive")
  engine "${args[@]}" > "$SELECTION_FILE" || { rm -f "$SELECTION_FILE"; SELECTION_FILE=""; return 1; }
  python3 -c 'import json,sys; print(",".join(json.load(open(sys.argv[1]))["categories"]))' \
    "$SELECTION_FILE"
}

pick_archive() {
  local start=${1:-$HOME/imprints}
  mkdir -p "$start"
  local found
  found=$(ls -1t "$start"/*.tar.zst "$HOME"/backups/*.tar.zst 2>/dev/null | awk '!seen[$0]++')
  [[ -n $found ]] || { echo "no archives in $start or ~/backups" >&2; return 1; }
  if (( HAVE_GUM )); then
    printf '%s\n' "$found" | engine menu --header "Choose an imprint archive"
  else
    printf '%s\n' "$found" | head -n 1
  fi
}

confirm() {
  local prompt=$1 ans
  [[ -t 0 ]] || return 1
  printf '  %s%s%s [y/N] ' "$IMP_BOLD" "$prompt" "$IMP_RESET"
  read -r ans </dev/tty || return 1
  [[ $ans == y || $ans == Y || $ans == yes ]]
}

do_save() {
  local only=${1:-}
  local output=${2:-}
  local all=${3:-0}
  banner
  if [[ -z $only && $all -eq 0 ]]; then
    if (( HAVE_GUM )); then
      PICK_ACTION="Start backup" only=$(choose_categories "What should this imprint carry?") || die "cancelled"
    else
      only=$(default_selected)
      say "No terminal for the picker; using the default categories."
    fi
  fi
  if [[ -z $output ]]; then
    local host
    host=$(hostname)
    mkdir -p "$HOME/imprints"
    output="$HOME/imprints/imprint-${host}-$(date +%Y%m%d-%H%M).tar.zst"
    if [[ -t 0 ]]; then
      local typed
      printf '  %sWrite archive to%s\n' "$IMP_BOLD" "$IMP_RESET"
      read -r -e -i "$output" typed </dev/tty && [[ -n $typed ]] && output=$typed
    fi
  fi
  [[ -n $output ]] || die "no output path"
  if [[ $all -eq 1 ]]; then
    engine save --all -o "$output" >/dev/null
  else
    engine save --only "$only" ${SELECTION_FILE:+--select "$SELECTION_FILE"} -o "$output" >/dev/null
  fi
  [[ -n $SELECTION_FILE ]] && rm -f "$SELECTION_FILE"
}

do_restore() {
  local archive=${1:-}
  local only=${2:-}
  local dry=${3:-0}
  local confirm_host=${4:-}
  local upgrade=${5:-0}
  local allow_system=${6:-0}
  banner
  if [[ -z $archive ]]; then
    archive=$(pick_archive) || die "cancelled"
  fi
  [[ -n $archive && -e $archive ]] || die "archive not found: $archive"
  engine verify "$archive" >/dev/null || die "archive failed verify"
  say "Archive $archive"
  if [[ -z $only ]]; then
    if (( HAVE_GUM )); then
      PICK_ACTION="Review changes" only=$(choose_categories "What should land on this machine?" "$archive") || die "cancelled"
    else
      only=$(ids_from_archive_defaults "$archive")
      say "No terminal for the picker; using this archive's default categories."
    fi
  fi
  [[ -n $only ]] || die "nothing selected"
  if printf '%s' "$only" | grep -q 'identity'; then
    warn "Identity will rename this host. Restore still needs --confirm-hostname."
  fi
  if printf '%s' "$only" | grep -q 'system'; then
    warn "System layer needs root. Without --allow-system it only writes a script for you to review."
  fi
  if printf '%s' "$only" | grep -q 'secrets'; then
    warn "Secrets copies SSH public keys and config, not private keys."
  fi
  local extra=()
  (( dry == 1 )) && extra+=(--dry-run)
  (( upgrade == 1 )) && extra+=(--upgrade)
  (( allow_system == 1 )) && extra+=(--allow-system)
  # These were parsed and then thrown away on the interactive path.
  [[ -n $confirm_host ]] && extra+=(--confirm-hostname "$confirm_host")
  [[ -n $SELECTION_FILE ]] && extra+=(--select "$SELECTION_FILE")

  # Say exactly what will change before asking for the go-ahead.
  engine preview "$archive" --only "$only" ${SELECTION_FILE:+--select "$SELECTION_FILE"}
  if [[ $dry -eq 0 ]]; then
    confirm "Apply these changes to this machine?" || { [[ -n $SELECTION_FILE ]] && rm -f "$SELECTION_FILE"; die "cancelled"; }
  fi
  engine restore "$archive" --only "$only" "${extra[@]}" >/dev/null
  [[ -n $SELECTION_FILE ]] && rm -f "$SELECTION_FILE"
}

do_list() {
  mkdir -p "$HOME/imprints"
  banner
  local files
  files=$(ls -1t "$HOME/imprints"/imprint-*.tar.zst 2>/dev/null || true)
  if [[ -z $files ]]; then
    say "No archives in ~/imprints yet. Run imprint save."
    return 0
  fi
  printf '%s\n' "$files" | while read -r f; do
    printf '  %s%8s%s  %s\n' "$IMP_GREY" "$(du -h "$f" | awk '{print $1}')" "$IMP_RESET" "$f"
  done
}

main_menu() {
  banner
  if (( HAVE_GUM == 0 )); then
    usage
    echo
    die "the menu needs a terminal; run one of the commands above"
  fi
  local choice
  choice=$(printf '%s\n' \
    "Save this machine" \
    "Restore onto this machine" \
    "Inspect an imprint" \
    "Diff against this machine" \
    "Undo last restore" \
    "List archives" \
    "About" \
    "Quit" | engine menu --header "What do you want to do?") || exit 0
  case $choice in
    "Save this machine") do_save ;;
    "Restore onto this machine") do_restore ;;
    "Inspect an imprint")
      local f
      f=$(pick_archive) || exit 0
      engine info "$f" | ${PAGER:-less -R}
      ;;
    "Diff against this machine")
      local f
      f=$(pick_archive) || exit 0
      engine diff "$f" | ${PAGER:-less -R}
      ;;
    "Undo last restore")
      confirm "Put back files from the last restore?" || exit 0
      engine undo
      ;;
    "List archives") do_list ;;
    "About") banner; engine about ;;
    "Quit") exit 0 ;;
  esac
}

cmd=${1:-}
shift || true

case $cmd in
  "" ) main_menu ;;
  -h|--help|help) usage ;;
  save)
    only=""
    output=""
    all=0
    while [[ $# -gt 0 ]]; do
      case $1 in
        --only) [[ $# -ge 2 ]] || die "--only needs a value"; only=$2; shift 2 ;;
        --all) all=1; shift ;;
        -o|--output) [[ $# -ge 2 ]] || die "--output needs a value"; output=$2; shift 2 ;;
        --yes) shift ;;
        *) die "unknown save flag: $1" ;;
      esac
    done
    if [[ -n $only || $all -eq 1 || $HAVE_GUM -eq 0 ]]; then
      [[ $all -eq 1 ]] || [[ -n $only ]] || only=$(default_selected)
      args=(save)
      [[ $all -eq 1 ]] && args+=(--all)
      [[ -n $only && $all -eq 0 ]] && args+=(--only "$only")
      [[ -n $output ]] && args+=(-o "$output")
      engine "${args[@]}"
    else
      do_save "$only" "$output" "$all"
    fi
    ;;
  restore)
    archive=""
    only=""
    dry=0
    upgrade=0
    allow_system=0
    confirm_host=""
    while [[ $# -gt 0 ]]; do
      case $1 in
        --only) [[ $# -ge 2 ]] || die "--only needs a value"; only=$2; shift 2 ;;
        --dry-run) dry=1; shift ;;
        --upgrade) upgrade=1; shift ;;
        --allow-system) allow_system=1; shift ;;
        --confirm-hostname) [[ $# -ge 2 ]] || die "--confirm-hostname needs a value"; confirm_host=$2; shift 2 ;;
        --yes) shift ;;
        -*) die "unknown restore flag: $1" ;;
        *) archive=$1; shift ;;
      esac
    done
    extra=()
    [[ $dry -eq 1 ]] && extra+=(--dry-run)
    [[ $upgrade -eq 1 ]] && extra+=(--upgrade)
    [[ $allow_system -eq 1 ]] && extra+=(--allow-system)
    [[ -n $confirm_host ]] && extra+=(--confirm-hostname "$confirm_host")
    if [[ -n $only && -n $archive ]]; then
      engine restore "$archive" --only "$only" "${extra[@]}"
    else
      do_restore "$archive" "$only" "$dry" "$confirm_host" "$upgrade" "$allow_system"
    fi
    ;;
  plan)
    [[ $# -ge 1 ]] || die "usage: imprint plan FILE [--only ...] [-o DIR]"
    engine plan "$@"
    ;;
  apply)
    [[ $# -ge 1 ]] || die "usage: imprint apply PLAN_DIR [--resume]"
    engine apply "$@"
    ;;
  preview)
    [[ $# -ge 1 ]] || die "usage: imprint preview FILE"
    engine preview "$@"
    ;;
  info|brief)
    [[ $# -ge 1 ]] || die "usage: imprint info FILE"
    engine info "$@"
    ;;
  diff)
    [[ $# -ge 1 ]] || die "usage: imprint diff FILE"
    engine diff "$1"
    ;;
  verify)
    [[ $# -ge 1 ]] || die "usage: imprint verify FILE"
    engine verify "$1"
    ;;
  undo)
    engine undo "$@"
    ;;
  list)
    do_list
    ;;
  categories)
    engine categories
    ;;
  facts)
    engine facts
    ;;
  about)
    engine about
    ;;
  *)
    usage
    exit 2
    ;;
esac
